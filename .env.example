# Telegram bot token from @BotFather (the ONLY secret the bot itself holds)
BOT_TOKEN=

# Forum supergroup chat id, e.g. -1003928470593
FORUM_CHAT_ID=

# Optional: model override (e.g. claude-opus-4-8). Default = SDK default.
MODEL=

# Optional: where sqlite + per-project working dirs live (default ./data)
DATA_DIR=

# NOTE: model auth is NOT set here. systemd delivers one credential to sessions via
# LoadCredential ($CREDENTIALS_DIRECTORY/anthropic), auto-detected by prefix:
#   sk-ant-oat…  -> subscription OAuth token (from `claude setup-token`, Pro/Max)
#   otherwise    -> ANTHROPIC_API_KEY (pay-per-token)
# For local dev you may instead export ANTHROPIC_API_KEY or CLAUDE_CODE_OAUTH_TOKEN.
